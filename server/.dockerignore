# Що НЕ потрапляє в контекст збірки.
#
# Це не оптимізація, а межа безпеки. Усе, що тут не виключене, Docker
# відправляє демону і може опинитися в шарі образу — а шари образу читає
# кожен, хто його завантажив. Видалити файл наступною командою RUN не
# допомагає: він лишається в попередньому шарі назавжди.

# Секрети. Найважливіший рядок у файлі.
.env
.env.*
!.env.example

# Залежності ставляться всередині образу під його платформу. Копіювати
# локальні означає притягти бінарники, зібрані під macOS, у linux-контейнер.
node_modules

# Артефакти збірки — образ збирає їх сам.
dist
dist-test
*.tsbuildinfo

# Рантайм-стан. Файли переїхали в об'єктне сховище (крок 7), але каталог
# може лишатися локально.
uploads

# Не потрібне застосунку в рантаймі.
.git
.gitignore
*.log
.DS_Store
README.md
