PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mockup
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
FRONTEND_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
OAUTH_STATE_SECRET=change-me-oauth-state-secret-min-32-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=

# ── Об'єктне сховище (S3-сумісне) ────────────────────────────────────────────
#
# Варіант А — MinIO у Docker (нічого не коштує, працює офлайн):
#   docker compose up -d minio minio-init
#   значення нижче вже підходять як є.
#
# Варіант Б — справжній Cloudflare R2:
#   STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_ACCESS_KEY_ID=<Access Key ID з R2 API token>
#   STORAGE_SECRET_ACCESS_KEY=<Secret Access Key>
#   STORAGE_REGION=auto
#   STORAGE_FORCE_PATH_STYLE=true
#
# У ENDPOINT назви бакета бути НЕ повинно. Cloudflare показує в інтерфейсі
# «S3 API» разом із бакетом на кінці — це інший рядок, він сюди не годиться.
#
# Перевірити налаштування:  npm run check:storage
STORAGE_BUCKET=mockup-uploads
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
# MinIO і R2 адресують бакет шляхом, а не піддоменом. Для AWS S3 — false.
STORAGE_FORCE_PATH_STYLE=true
# Час життя підписаного посилання на приватний файл, секунди.
STORAGE_SIGNED_URL_TTL=60
