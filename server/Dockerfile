# Образ бекенда.
#
# Три стадії, і кожна існує з конкретної причини, а не «бо так пишуть».
# Головна ідея: те, що потрібно ЩОБ ЗІБРАТИ, і те, що потрібно ЩОБ ЗАПУСТИТИ, —
# різні речі. TypeScript, типи, ts-node-dev потрібні першому й нікому не
# потрібні в проді. Усе, що поїхало в фінальний образ, — це поверхня атаки,
# яку хтось має оновлювати до кінця життя сервісу.

# ── Спільна база ─────────────────────────────────────────────────────────────
# Alpine, бо різниця з повним debian-образом — сотні мегабайт на кожному
# завантаженні, на кожному вузлі, при кожному деплої.
# Версія закріплена дайджестом: тег 22-alpine перепризначають, і тоді збірка
# на одному й тому ж коміті дає різні образи. Оновлює Renovate.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
WORKDIR /app

# ── Стадія 1: залежності для збірки ──────────────────────────────────────────
FROM base AS deps
# Спершу тільки маніфести. Docker кешує шар за їхнім вмістом: доки
# package-lock.json не змінився, npm ci не виконується повторно, навіть якщо
# увесь код переписано. Скопіювати код раніше — означає інвалідувати кеш на
# кожну правку й ставити залежності щоразу з нуля.
COPY package.json package-lock.json ./
RUN npm ci

# ── Стадія 2: збірка ─────────────────────────────────────────────────────────
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

# ── Стадія 3: продові залежності ─────────────────────────────────────────────
# Окремий npm ci --omit=dev замість видалення зайвого з готового node_modules:
# видалення лишає файли в попередньому шарі, тобто розмір образу не змінюється.
FROM base AS prod-deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ── Фінальний образ ──────────────────────────────────────────────────────────
FROM base AS runtime

ENV NODE_ENV=production

# Розмір heap Node прив'язаний до ліміту пам'яті контейнера.
#
# Проблема, яку це вирішує: Node за замовчуванням визначає розмір heap із
# ПОВНОЇ пам'яті хоста, а не з cgroup-ліміту контейнера. На машині з 64 ГБ він
# дозволить собі рости майже без обмежень, а контейнер із лімітом 512 МБ буде
# вбито ядром (OOMKilled) ще до того, як GC вирішить, що пора прибирати.
#
# Симптом у проді: контейнери гинуть під навантаженням без жодної помилки в
# логах — процес не падає, його вбивають ззовні. Знайти це важко саме тому,
# що застосунок не встигає нічого сказати.
#
# 384 МБ при ліміті 512 МБ: решта потрібна самому Node поза heap — стек,
# буфери, нативні модулі (bcrypt тут якраз такий).
# Значення перевизначається змінною оточення, якщо машина буде більшою.
ENV NODE_OPTIONS="--max-old-space-size=384"

# Скільки чекати після SIGTERM, перш ніж закривати сокет. Нуль означає
# «закривати одразу»; на платформі з балансувальником сюди ставлять час,
# більший за інтервал його readiness-перевірки (див. fly.toml).
ENV SHUTDOWN_DRAIN_MS=0
# tini як PID 1: Node у ролі першого процесу не пересилає сигнали й не збирає
# зомбі-процеси. Без нього `docker stop` чекає десять секунд і вбиває процес
# силою — тобто кожен деплой обриває запити, які були в роботі.
RUN apk add --no-cache tini

# Непривілейований користувач. Образ node:alpine уже містить користувача
# `node` (uid 1000) — власного створювати не треба.
# Це не формальність: діра в застосунку під root дає владу над усім
# контейнером, під node — правами одного процесу.
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./

USER node

EXPOSE 4000

# Healthcheck перевіряє ЗАСТОСУНОК, а не процес. Процес може бути живим і при
# цьому не відповідати — саме цей стан платформа має вміти відрізняти, щоб
# перезапустити контейнер або не пускати на нього трафік.
# Використовуємо node, а не curl: його немає в alpine, і ставити цілий пакет
# заради одного запиту — зайві мегабайти й зайва поверхня.
# Docker має лише одну перевірку, тож тут — liveness: «чи допоможе перезапуск».
# Readiness (/health/ready, з перевіркою бази) використовує балансувальник
# платформи — див. fly.toml. Плутати їх не можна: liveness, зав'язаний на базу,
# перезапустив би всі інстанси одночасно при першому ж морганні Mongo.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
