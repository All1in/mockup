{
  // Прод-збірка: те саме, що tsconfig.json, але без тестів.
  //
  // Окремий файл, а не виключення в основному конфізі, бо у цих двох конфігів
  // різні задачі: tsconfig.json описує «весь код проєкту» і ним користуються
  // typecheck та IDE, а цей — «що саме потрапляє в артефакт». Тести в
  // dist/ нікому не потрібні: вони збільшують образ і тягнуть у прод код,
  // який ходить у тестові сервіси.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "dist", "dist-test", "src/**/*.test.ts"]
}
